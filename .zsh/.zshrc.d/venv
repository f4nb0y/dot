# Python virtual env

venv() {
    if (( $# == 0 )) ; then
        print "Usage: $0 <path>" >&2
        return 1
    elif [[ ! -f $1/pyvenv.cfg ]] ; then
        print "$0: Cannot find $1/pyvenv.cfg" >&2
        return 1
    fi

    VENV=$( cd $1 && pwd ) $SHELL
}

precmd_venv_info() {
    if [[ -n ${VENV-} ]] ; then
        venv_info=" venv:$(basename $VENV)"
    else
        venv_info=
    fi
}
precmd_functions+=( precmd_venv_info )
RPS1='${venv_info}'$RPS1

if [[ -n ${VENV-} && -d $VENV/bin ]] ; then
    PATH=$VENV/bin:$PATH
fi
